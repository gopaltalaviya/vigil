{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "description": "A post-quantum rollup on QoreChain with a watchtower that checks every batch.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "golden:refresh": "tsx scripts/refresh-golden.ts",
    "live:probe": "tsx scripts/live-probe.ts",
    "watchtower": "tsx packages/watchtower/src/main.ts",
    "vigil": "tsx packages/wallet/src/main.ts",
    "batcher": "tsx packages/batcher/src/main.ts",
    "rollup:bootstrap": "tsx scripts/bootstrap-rollup.ts",
    "receipts": "tsx packages/receipts/src/main.ts",
    "gen:abi": "tsx scripts/gen-abi.ts",
    "fraud:drill": "tsx scripts/fraud-drill.ts",
    "monitor": "tsx packages/monitor/src/main.ts",
    "api": "tsx packages/api/src/main.ts",
    "console": "tsx packages/console/src/main.ts",
    "mcp": "tsx packages/mcp/src/main.ts",
    "verify:proof": "node scripts/verify-proof.mjs",
    "metrics": "tsx scripts/metrics.ts",
    "cbom": "qorescan scan --name vigil --network testnet --address qor1x2jpzzxspw9yl59uwgxyjtxnx8clehnwt2yt0c --tls evm-testnet.qore.host:443 --tls api-testnet.qore.host:443 --solidity contracts --out docs/cbom.json && node scripts/check-cbom.mjs docs/cbom.json",
    "video": "node scripts/video/record.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@qorechain/qore-cli": "0.1.1",
    "@qorechain/qorescan": "0.1.0",
    "@qorechain/rdk": "0.9.0",
    "@types/node": "24.19.2",
    "@vigil/core": "workspace:*",
    "@vigil/receipts": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "viem": "2.57.20",
    "vitest": "5.1.0"
  }
}

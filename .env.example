# Vigil: copy this file to .env and fill it in. Never commit .env.
# Use a TESTNET-ONLY wallet created for this project. Never put a mainnet seed phrase here.

# Seed phrase of the testnet account that pays for transactions (rollup creator / bonded submitter)
QORE_MNEMONIC=""

# Optional: 32-byte hex seed for the ML-DSA-87 key, only if the key is not derived from the mnemonic
QORE_PQC_SEED_HEX=""

# Passphrase that encrypts the local L2 keystore file (wallet command line)
VIGIL_KEYSTORE_PASSPHRASE=""

# Throwaway seed phrase used only by the fraud drill (its bond gets slashed)
QORE_DRILL_MNEMONIC=""

# Network
QORE_NETWORK="testnet"
QORE_CHAIN_ID="qorechain-diana"
QORE_RPC_URL="https://rpc-testnet.qore.host"
QORE_REST_URL="https://api-testnet.qore.host"
QORE_EVM_RPC_URL="https://evm-testnet.qore.host"

# "own": Vigil created the rollup and signs anchors. "shared": Vigil works on an existing rollup.
VIGIL_MODE="own"

# Rollup to operate on
ROLLUP_ID="vigil-1"

# Where the local database lives
VIGIL_DATA_DIR="./data"

# Logging: fatal, error, warn, info, debug or trace
LOG_LEVEL="info"

# Address of the deployed VigilReceipts contract (EVM side of the same network)
VIGIL_RECEIPTS_ADDRESS=""

# Batcher service
BATCHER_INTERVAL_MS="20000"
BATCHER_HEALTH_PORT="8082"

# Watchtower service
WATCHTOWER_INTERVAL_MS="15000"
WATCHTOWER_HEALTH_PORT="8081"
# What to do about an invalid batch: off (alert only), dry-run (build the proof), on (challenge)
WATCHTOWER_CHALLENGE="off"

# Monitor and API services
MONITOR_INTERVAL_MS="60000"
API_PORT="8080"

# Operator console (the web app with wallet actions). At least 12 characters.
VIGIL_CONSOLE_PASSWORD=""
CONSOLE_PORT="8090"
# Set to 1 when a reverse proxy on the same host fronts the API or console
TRUST_PROXY="0"

# How often the receipts service looks for newly finalized batches
RECEIPTS_INTERVAL_MS="120000"

# Optional alert destinations for the watchtower
ALERT_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
